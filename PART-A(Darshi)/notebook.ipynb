import cv2
import pydicom
import numpy as np
from tqdm.auto import tqdm


def convert_dicom_to_yolo(patient_id, split):
    
    # Path of the DICOM image in the attached dataset
    dcm_path = DICOM_DIR / f"{patient_id}.dcm"

    # Skip if DICOM file does not exist
    if not dcm_path.exists():
        return False

    # Read DICOM file
    dicom_file = pydicom.dcmread(dcm_path)

    # Get original X-ray image
    image = dicom_file.pixel_array.astype(np.float32)

    # Store original dimensions
    original_height, original_width = image.shape[:2]

    # Normalize pixel values between 0 and 255
    image = image - image.min()

    if image.max() > 0:
        image = image / image.max()

    image = (image * 255).astype(np.uint8)

    # Convert grayscale image to 3-channel image
    image = cv2.cvtColor(image, cv2.COLOR_GRAY2RGB)

    # Resize image to 1024 x 1024
    image = cv2.resize(
        image,
        (IMG_SIZE, IMG_SIZE)
    )

    # Select the correct output folders
    if split == "train":
        image_dir = TRAIN_IMG_DIR
        label_dir = TRAIN_LABEL_DIR
    else:
        image_dir = VAL_IMG_DIR
        label_dir = VAL_LABEL_DIR

    # Save converted image
    image_path = image_dir / f"{patient_id}.png"

    cv2.imwrite(
        str(image_path),
        cv2.cvtColor(image, cv2.COLOR_RGB2BGR)
    )

    # Get annotations for this patient
    patient_rows = labels[
        labels["patientId"] == patient_id
    ]

    yolo_labels = []

    for _, row in patient_rows.iterrows():

        # Target = 1 means pneumonia is present
        if row["Target"] == 1:

            x = row["x"]
            y = row["y"]
            width = row["width"]
            height = row["height"]

            # Scale bounding box according to resized image
            x = x * IMG_SIZE / original_width
            y = y * IMG_SIZE / original_height
            width = width * IMG_SIZE / original_width
            height = height * IMG_SIZE / original_height

            # Convert to YOLO format
            x_center = (x + width / 2) / IMG_SIZE
            y_center = (y + height / 2) / IMG_SIZE

            width_normalized = width / IMG_SIZE
            height_normalized = height / IMG_SIZE

            # YOLO class 0 = pneumonia
            yolo_labels.append(
                f"0 {x_center:.6f} "
                f"{y_center:.6f} "
                f"{width_normalized:.6f} "
                f"{height_normalized:.6f}"
            )

    # Save YOLO label file
    label_path = label_dir / f"{patient_id}.txt"

    with open(label_path, "w") as f:
        f.write("\n".join(yolo_labels))

    return True


print("Converting training images...")
print("=" * 50)

