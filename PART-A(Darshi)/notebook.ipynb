def count_positive_negative(label_dir):
    
    positive = 0
    negative = 0
    
    for label_file in label_dir.glob("*.txt"):
        
        with open(label_file, "r") as f:
            content = f.read().strip()
        
        if content:
            positive += 1
        else:
            negative += 1
    
    return positive, negative


