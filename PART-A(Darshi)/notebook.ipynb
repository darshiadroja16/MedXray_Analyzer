import cv2
import matplotlib.pyplot as plt
from pathlib import Path

# Get some validation images
sample_images = list(VAL_IMG_DIR.glob("*.png"))[:5]

print("Images selected for checking:", len(sample_images))


for image_path in sample_images:

    # Read image
    image = cv2.imread(str(image_path))
    image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    # Corresponding YOLO label file
    label_path = VAL_LABEL_DIR / f"{image_path.stem}.txt"

    # Read image dimensions
    height, width = image.shape[:2]

    # Draw bounding boxes
    if label_path.exists():

        with open(label_path, "r") as f:
            lines = f.readlines()

        for line in lines:

            values = line.strip().split()

            if len(values) != 5:
                continue

            class_id, x_center, y_center, box_width, box_height = map(
                float, values
            )

            # Convert YOLO normalized coordinates
            # back to pixel coordinates
            x_center = x_center * width
            y_center = y_center * height

            box_width = box_width * width
            box_height = box_height * height

            x1 = int(x_center - box_width / 2)
            y1 = int(y_center - box_height / 2)

            x2 = int(x_center + box_width / 2)
            y2 = int(y_center + box_height / 2)

            # Draw bounding box
            cv2.rectangle(
                image,
                (x1, y1),
                (x2, y2),
                (255, 0, 0),
                2
            )

            # Add class name
            cv2.putText(
                image,
                "pneumonia",
                (x1, max(y1 - 10, 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (255, 0, 0),
                2
            )

    # Display image
    plt.figure(figsize=(7, 7))
    plt.imshow(image)
    plt.title(image_path.stem)
    plt.axis("off")
    plt.show()


from collections import Counter

def get_dataset_statistics(image_dir, label_dir):
    
    total_images = 0
    positive_images = 0
    negative_images = 0
    total_boxes = 0
    
    box_counts = []
    
    for image_path in image_dir.glob("*.png"):
        
        total_images += 1
        
        label_path = label_dir / f"{image_path.stem}.txt"
        
        if not label_path.exists():
            continue
        
        with open(label_path, "r") as f:
            lines = [line.strip() for line in f if line.strip()]
        
        number_of_boxes = len(lines)
        
        total_boxes += number_of_boxes
        box_counts.append(number_of_boxes)
        
        if number_of_boxes > 0:
            positive_images += 1
        else:
            negative_images += 1
    
    return {
        "total_images": total_images,
        "positive_images": positive_images,
        "negative_images": negative_images,
        "total_boxes": total_boxes,
        "average_boxes": (
            total_boxes / positive_images
            if positive_images > 0
            else 0
        )
    }


train_stats = get_dataset_statistics(
    TRAIN_IMG_DIR,
    TRAIN_LABEL_DIR
)

val_stats = get_dataset_statistics(
    VAL_IMG_DIR,
    VAL_LABEL_DIR
)

